# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

# Frontend — public Razorpay key, safe to expose in React build
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ANNAI_ADMIN_PIN=change-me-in-production
ANNAI_CORS_ORIGIN=http://localhost:5173
ANNAI_DB_PATH=

# Backend only Razorpay keys — NEVER prefix with VITE_ (VITE_ vars are
# bundled into the public JS build and visible to everyone in the browser).
# WARNING: Never rename RAZORPAY_KEY_SECRET to VITE_RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_secret_key_here

# Email (for order receipts)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ANNAI HEALTH MASALA <your@gmail.com>
ADMIN_EMAIL=your@gmail.com
